# Cyber Intelligence archive
#
# Copy to `.env.local` for local development, or set these in the deployment
# project. Every value is server-only: none of them are exposed to the browser.

# Durable archive. Required for a deployment whose storage survives redeploys.
# Any Postgres provider works; `sslmode` in the URL is honoured. `DATABASE_URL`
# is used as a fallback when this is unset.
CYBER_INTEL_DATABASE_URL=

# Local development fallback. A SQLite file survives restarts but NOT a
# redeploy, and the API/UI report it as non-durable. Ignored when a Postgres URL
# is configured.
# CYBER_INTEL_SQLITE_PATH=.data/cyber-intel.sqlite
# CYBER_INTEL_DATA_DIR=.data/cyber-intel

# Bearer token for POST /api/cyber-intel/ingest. When unset the endpoint is
# disabled (HTTP 503) rather than open.
CYBER_INTEL_INGEST_TOKEN=

# Bearer token for GET /api/cron/cyber-intel. Vercel Cron sends
# `Authorization: Bearer $CRON_SECRET`. Falls back to CYBER_INTEL_INGEST_TOKEN.
CRON_SECRET=

# Set to 0 to stop request-triggered refreshes and rely on the scheduler only.
# CYBER_INTEL_INGEST_ON_REQUEST=1

# Optional Postgres tuning.
# CYBER_INTEL_PG_SSL=disable
# CYBER_INTEL_PG_POOL_MAX=5
